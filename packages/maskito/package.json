{
  "name": "@ember-formwright/maskito",
  "version": "1.2.0",
  "description": "Masked inputs for Formwright, powered by Maskito.",
  "keywords": [
    "ember-addon",
    "ember",
    "forms",
    "formwright",
    "maskito",
    "input-mask"
  ],
  "license": "MIT",
  "author": "Joe Gaudet <joe@joegaudet.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joegaudet/ember-formwright.git",
    "directory": "packages/maskito"
  },
  "homepage": "https://joegaudet.com/ember-formwright/",
  "bugs": "https://github.com/joegaudet/ember-formwright/issues",
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./phone": {
      "types": "./declarations/phone.d.ts",
      "default": "./dist/phone.js"
    },
    "./test-support": {
      "types": "./declarations/test-support/index.d.ts",
      "default": "./dist/test-support/index.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*"
      ]
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup --config",
    "start": "rollup --config --watch",
    "typecheck": "ember-tsc --noEmit",
    "prepack": "rollup --config"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.3",
    "decorator-transforms": "^2.4.0",
    "ember-modifier": "^4.3.0"
  },
  "peerDependencies": {
    "@ember-formwright/ember": "workspace:^",
    "@ember-formwright/test-support": "workspace:^",
    "@ember/test-helpers": ">= 5.0.0",
    "@maskito/core": ">= 5.0.0",
    "@maskito/kit": ">= 5.0.0",
    "@maskito/phone": ">= 5.0.0",
    "ember-source": ">= 6.12.0",
    "libphonenumber-js": ">= 1.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@ember-formwright/ember": "workspace:*",
    "@ember-formwright/test-support": "workspace:*",
    "@ember/library-tsconfig": "^3.0.0",
    "@ember/test-helpers": "^5.7.0",
    "@embroider/addon-dev": "^8.4.2",
    "@glimmer/component": "^2.2.1",
    "@glimmer/tracking": "^1.1.2",
    "@glint/ember-tsc": "^1.14.2",
    "@glint/template": "^1.9.0",
    "@maskito/core": "^5.6.1",
    "@maskito/kit": "^5.6.1",
    "@maskito/phone": "^5.6.1",
    "@rollup/plugin-babel": "^7.1.0",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "ember-source": "~7.3.0",
    "libphonenumber-js": "^1.13.15",
    "rollup": "^4.64.6",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs"
  },
  "peerDependenciesMeta": {
    "@ember-formwright/test-support": {
      "optional": true
    },
    "@ember/test-helpers": {
      "optional": true
    },
    "@maskito/kit": {
      "optional": true
    },
    "@maskito/phone": {
      "optional": true
    },
    "libphonenumber-js": {
      "optional": true
    }
  }
}
