{
  "name": "formwright-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "repository": "https://github.com/joegaudet/formwright",
  "scripts": {
    "build": "pnpm --filter './packages/*' run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter test-app test",
    "test:examples": "pnpm --filter './examples/*' run test",
    "demo:build": "pnpm --filter test-app run build:demo",
    "start": "pnpm --filter test-app start",
    "release": "pnpm build && node scripts/publish.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.6.1",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
